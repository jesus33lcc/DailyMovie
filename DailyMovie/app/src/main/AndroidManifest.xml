<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La app pide peliculas a TMDB y datos a Firebase, asi que necesita internet.
         Funcionaba sin declararlo porque lo aportan las librerias al fusionar el
         manifest, pero conviene que este a la vista de quien lea el proyecto. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyMovie"
        tools:targetApi="31">
        <activity
            android:name=".activities.views.SerieA"
            android:exported="false" />
        <activity
            android:name=".activities.views.GaleriaA"
            android:exported="false" />
        <activity
            android:name=".activities.views.EstadisticasA"
            android:exported="false" />
        <activity
            android:name=".activities.views.SagaA"
            android:exported="false" />
        <activity
            android:name=".activities.views.PersonaA"
            android:exported="false" />
        <activity
            android:name=".activities.views.OnboardingA"
            android:exported="false" />
        <activity
            android:name=".activities.views.ListMoviesA"
            android:exported="false" />
        <activity
            android:name=".activities.views.MovieA"
            android:exported="false" />
        <activity
            android:name=".activities.views.PrincipalA"
            android:exported="false" />
        <activity
            android:name=".activities.views.LoginA"
            android:exported="false" />
        <activity
            android:name=".activities.views.RegistroA"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.DailyMovie.Arranque"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
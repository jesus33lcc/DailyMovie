<?xml version="1.0" encoding="utf-8"?>
<!--
    "Aqui no hay imagen", para fotogramas, capturas de episodio y trailers.

    El simbolo es una imagen tachada: lo que importa no es de que es la ficha, sino que la
    imagen falta. Antes habia un icono decorativo por tipo (claqueta, silueta, montaña) y no
    se entendia si era un adorno o si algo habia fallado.

    Fondo y simbolo van dentro del mismo vector y el lienzo tiene la proporcion de lo que
    rellena, para que al escalarlo el simbolo se quede pequeño y centrado.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp" android:height="90dp"
    android:viewportWidth="160" android:viewportHeight="90">
    <path android:fillColor="@color/colorAccent" android:pathData="M0,0h160v90h-160z" />
    <group android:translateX="65" android:translateY="30" android:scaleX="1.25" android:scaleY="1.25">
        <path android:fillColor="@color/colorPrimaryDark" android:pathData="M21.9,21.9l-8.49,-8.49l0,0L3.59,3.59l0,0L2.1,2.1L0.69,3.51L3,5.83V19c0,1.1 0.9,2 2,2h13.17l2.31,2.31L21.9,21.9zM5,18l3.5,-4.5l2.5,3.01L12.17,15l3,3H5zM21,18.17L5.83,3H19c1.1,0 2,0.9 2,2V18.17z" />
    </group>
</vector>

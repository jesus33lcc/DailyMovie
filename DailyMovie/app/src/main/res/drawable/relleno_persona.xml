<?xml version="1.0" encoding="utf-8"?>
<!--
    Relleno de cuando no hay imagen.

    Antes se usaba el mismo icono gris de Android para todo: peliculas, series, personas y
    episodios. Ahora cada cosa tiene el suyo y va con los colores de la app.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorAccent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_relleno_persona"
        android:gravity="center"
        android:width="48dp"
        android:height="48dp" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Los chips de filtrar. Se hacen a mano y no con los de Material para que salgan con la
    paleta de la app sin pelearse con el tema, igual que se hizo con los botones de temporada.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimary" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorAccent" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/colorPrimaryDark" />
        </shape>
    </item>
</selector>

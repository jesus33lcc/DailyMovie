<?xml version="1.0" encoding="utf-8"?>
<!--
    Medidas para pantallas grandes (tablets, a partir de 600dp de ancho).

    Con las mismas medidas que en un movil, en una tablet los carteles se ven diminutos y
    queda mucho aire desaprovechado. Aqui se agrandan sin tocar ni un layout.
-->
<resources>
    <dimen name="recycler_view_spacing">12dp</dimen>
    <dimen name="poster_ancho">180dp</dimen>
    <dimen name="poster_alto">270dp</dimen>
    <dimen name="foto_persona_ancho">160dp</dimen>
    <dimen name="foto_persona_alto">200dp</dimen>

    <dimen name="poster_ficha_ancho">280dp</dimen>
    <dimen name="poster_ficha_alto">420dp</dimen>
    <dimen name="foto_ficha_persona">240dp</dimen>

    <!-- En una pantalla grande cabe algo mas de texto por linea sin que canse -->
    <dimen name="ancho_maximo_lectura">720dp</dimen>

    <dimen name="imagen_ancho">320dp</dimen>
    <dimen name="imagen_alto">180dp</dimen>
    <dimen name="video_ancho">420dp</dimen>
    <dimen name="video_alto">236dp</dimen>
</resources>

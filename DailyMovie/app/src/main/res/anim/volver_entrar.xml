<?xml version="1.0" encoding="utf-8"?>
<!-- Al volver atras, la de debajo recupera su tamaño y su color -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0.7" android:toAlpha="1.0" android:duration="240" />
    <scale android:fromXScale="0.97" android:toXScale="1.0"
        android:fromYScale="0.97" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="240" />
</set>

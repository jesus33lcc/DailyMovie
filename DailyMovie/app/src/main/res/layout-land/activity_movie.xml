<?xml version="1.0" encoding="utf-8"?>
<!--
    La ficha de pelicula en apaisado.

    Mismo reparto que la portada: el cartel a la izquierda y los datos a la derecha. En
    vertical todo va en columna y hay que bajar para leer nada, pero aqui cabe de sobra al
    lado y la ficha se ve entera de un vistazo.

    Los ids son exactamente los mismos que en el layout vertical. Es obligatorio: ViewBinding
    genera una sola clase para las dos versiones, y si a una le falta un id el campo pasa a
    ser nulo y MovieA deja de compilar.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.views.MovieA"
    android:background="@color/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera a dos columnas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Izquierda: el cartel y lo que se hace con la pelicula -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/rounded_border_box_big"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/img_poster_movie"
                            android:layout_width="@dimen/poster_ficha_ancho"
                            android:layout_height="@dimen/poster_ficha_alto"
                            android:layout_gravity="center_horizontal"
                            android:scaleType="centerCrop"
                            android:contentDescription="Póster de la película"
                            android:background="@drawable/image_rounded_border"
                            android:clipToOutline="true" />

                        <TextView
                            android:id="@+id/txt_titulo_movie"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="24sp"
                            android:fontFamily="@font/courier_prime_bold"
                            android:textAlignment="center"
                            android:paddingTop="8dp"
                            android:textColor="@color/black"
                            android:text="" />

                        <TextView
                            android:id="@+id/txt_tagline_movie"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="italic"
                            android:textAlignment="center"
                            android:paddingTop="4dp"
                            android:textColor="@color/black"
                            android:text="" />

                        <TextView
                            android:id="@+id/txt_clasificacion_edad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:textSize="16sp"
                            android:fontFamily="@font/courier_prime_bold"
                            android:background="@drawable/rounded_border"
                            android:textColor="@color/colorTextPrimary"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:weightSum="4">

                        <ImageButton
                            android:id="@+id/btnFavorite"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_baseline_favorite_border_24"
                            android:scaleType="centerInside"
                            android:padding="2dp"
                            android:contentDescription="Favoritos"
                            app:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/btnWatched"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_baseline_visibility_off_24"
                            android:scaleType="centerInside"
                            android:padding="2dp"
                            android:contentDescription="Vistos"
                            app:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/btnAddList"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_baseline_playlist_add_24"
                            android:scaleType="centerInside"
                            android:padding="2dp"
                            android:contentDescription="Añadir a lista"
                            app:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/btnShare"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button"
                            android:src="@drawable/ic_baseline_share_24"
                            android:scaleType="centerInside"
                            android:padding="2dp"
                            android:contentDescription="Compartir"
                            app:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Derecha: los datos. Pesa algo mas porque es donde va el texto largo -->
                <LinearLayout
                    android:id="@+id/sectionDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_border_box"
                    android:clipToOutline="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/txt_director_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Director: "
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/courier_prime_bold"/>

                        <TextView
                            android:id="@+id/txt_director_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:text=""
                            android:layout_marginStart="8dp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/txt_runtime_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duración: "
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_runtime_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/txt_anio_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Año: "
                            android:textSize="16sp"
                            android:layout_marginStart="24dp"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_anio_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/txt_valoracion_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Valoración: "
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_valoracion_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_overview_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descripción: "
                        android:textSize="20sp"
                        android:paddingTop="8dp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/courier_prime_bold"/>

                    <TextView
                        android:id="@+id/txt_overview_movie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp"
                        android:paddingTop="8dp"
                        android:justificationMode="inter_word"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/txt_genres_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Géneros: "
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_genres_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginStart="8dp"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/txt_budget_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Presupuesto: "
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_budget_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/txt_revenue_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recaudación: "
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_revenue_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginStart="8dp"
                            android:textColor="@color/black" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- De aqui abajo, todo a lo ancho: son listas horizontales y cuanto mas
                 espacio tienen, mas peliculas se ven sin arrastrar -->
            <LinearLayout
                android:id="@+id/sectionProviders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtProvidersLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proveedores"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewProviders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:scrollbars="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionCredits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtCreditsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reparto"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewCredits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:scrollbars="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionImagenes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Imágenes"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerImagenes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtVideoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Videos"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:fontFamily="@font/courier_prime_bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerVideos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!--
                Cuando la pelicula es parte de una saga.

                Va justo antes de "Similares" porque es lo mas cercano que hay: quien ve la
                segunda parte casi siempre quiere el resto, no algo que se le parezca.
            -->
            <LinearLayout
                android:id="@+id/sectionSaga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgSaga"
                    android:layout_width="60dp"
                    android:layout_height="90dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Cartel de la saga" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forma parte de"
                        android:fontFamily="@font/courier_prime"
                        android:textSize="14sp"
                        android:textColor="@color/colorAccent" />

                    <TextView
                        android:id="@+id/txtSaga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/courier_prime_bold"
                        android:textSize="19sp"
                        android:textColor="@color/black"
                        tools:text="El padrino - Colección" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ver todas las películas"
                        android:fontFamily="@font/courier_prime"
                        android:textSize="14sp"
                        android:textColor="@color/colorAccent" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionSimilarMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtSimilarMoviesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Similares"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewSimilarMovies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:scrollbars="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionRecommendedMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtRecommendedMoviesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recomendadas"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewRecommendedMovies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:scrollbars="horizontal" />
            </LinearLayout>

            <!--
                Lo que ha escrito la gente en TMDB.

                Va al final del todo: es lo que menos gente lee y ademas puede ocupar mucho,
                asi que no debe empujar hacia abajo lo importante.
            -->
            <LinearLayout
                android:id="@+id/sectionResenas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lo que dice la gente"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textSize="25sp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewResenas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_resena" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    La ficha de una persona en apaisado.

    Igual que la de pelicula y que la portada: la foto a la izquierda y lo que se cuenta de
    ella a la derecha. En vertical la biografia queda debajo de la foto y hay que bajar para
    empezar a leerla.

    Los ids son los mismos que en el layout vertical; si faltase alguno, ViewBinding lo
    marcaria como nulo y PersonaA no compilaria.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.views.PersonaA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Izquierda: la foto y quien es -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgPersona"
                    android:layout_width="@dimen/foto_ficha_persona"
                    android:layout_height="@dimen/foto_ficha_persona"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_border"
                    android:clipToOutline="true"
                    android:contentDescription="Foto"
                    tools:src="@drawable/ic_baseline_image_24" />

                <TextView
                    android:id="@+id/txtNombrePersona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="26sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textColor="@color/black"
                    tools:text="Marlon Brando" />

                <TextView
                    android:id="@+id/txtOficioPersona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier_prime"
                    android:textColor="@color/colorAccent"
                    tools:text="Interpretación" />

                <TextView
                    android:id="@+id/txtDatosPersona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier_prime"
                    android:textColor="@color/colorTextPrimary"
                    tools:text="3 de abril de 1924 · Omaha, Nebraska" />
            </LinearLayout>

            <!-- Derecha: la biografia, que es lo que necesita sitio para leerse -->
            <LinearLayout
                android:id="@+id/seccionBiografia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biografía"
                    android:textSize="22sp"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/txtBiografia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:textSize="15sp"
                    android:justificationMode="inter_word"
                    android:background="@drawable/rounded_border_box"
                    android:fontFamily="@font/courier_prime"
                    android:textColor="@color/colorTextPrimary"
                    tools:text="Actor estadounidense..." />
            </LinearLayout>
        </LinearLayout>

        <!-- La filmografia, a lo ancho: cuanto mas sitio, mas peliculas se ven de golpe -->
                <!-- Fotos de la persona. Solo aparece si TMDB tiene alguna -->
        <LinearLayout
        android:id="@+id/seccionFotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_border_box_big"
        android:clipToOutline="true"
        android:visibility="gone">

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fotos"
        android:textSize="22sp"
        android:fontFamily="@font/courier_prime_bold"
        android:textColor="@color/black" />

        <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />
        </LinearLayout>

<LinearLayout
            android:id="@+id/seccionActuando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ha actuado en"
                android:textSize="22sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActuando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seccionDirigiendo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ha dirigido"
                android:textSize="22sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDirigiendo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    La ficha de una serie en apaisado.

    Mismo reparto que la de pelicula: cartel a la izquierda y datos a la derecha. Las
    temporadas y los episodios van debajo a lo ancho, que es donde mas se agradece el sitio
    porque cada episodio lleva su imagen, su fecha y su sinopsis en una fila.

    Los ids son los mismos que en el layout vertical, o ViewBinding rompe SerieA.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.views.SerieA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Izquierda: el cartel y los cuatro datos de cabecera -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgPosterSerie"
                    android:layout_width="@dimen/poster_ficha_ancho"
                    android:layout_height="@dimen/poster_ficha_alto"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_border"
                    android:clipToOutline="true"
                    android:contentDescription="Cartel de la serie"
                    tools:src="@drawable/ic_baseline_image_24" />

                <TextView
                    android:id="@+id/txtTituloSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="26sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier_prime_bold"
                    android:textColor="@color/black"
                    tools:text="Breaking Bad" />

                <TextView
                    android:id="@+id/txtDatosSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier_prime"
                    android:textColor="@color/colorAccent"
                    tools:text="2008 — 2013 · 5 temporadas · 62 episodios" />

                <!-- Cuanto llevas visto de la serie entera. Solo aparece si has marcado algo -->
                <TextView
                android:id="@+id/txtProgresoSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textAlignment="center"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/colorPrimaryDark"
                android:visibility="gone"
                tools:text="Llevas 12 de 62 episodios"
                tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtEstadoSerie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/courier_prime_bold"
                    android:background="@drawable/rounded_border"
                    android:textColor="@color/colorTextPrimary"
                    tools:text="Terminada" />

                <!-- Clasificacion por edad del pais del usuario. En peliculas ya salia; en series
                hay que pedirla aparte, y ademas hace falta para la ficha de Google Play -->
                <TextView
                android:id="@+id/txtClasificacionSerie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:textSize="16sp"
                android:fontFamily="@font/courier_prime_bold"
                android:background="@drawable/rounded_border"
                android:textColor="@color/colorTextPrimary"
                android:visibility="gone"
                tools:text="16"
                tools:visibility="visible" />

                <!-- Los mismos gestos que en la ficha de pelicula: hasta ahora una serie se
                     podia mirar pero no guardar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:weightSum="5">

                    <ImageButton
                        android:id="@+id/btnFavoritaSerie"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/rounded_button"
                        android:src="@drawable/ic_baseline_favorite_border_24"
                        android:scaleType="centerInside"
                        android:padding="2dp"
                        android:contentDescription="Favoritos"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnVistaSerie"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/rounded_button"
                        android:src="@drawable/ic_baseline_visibility_off_24"
                        android:scaleType="centerInside"
                        android:padding="2dp"
                        android:contentDescription="Vistos"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnAnadirListaSerie"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/rounded_button"
                        android:src="@drawable/ic_baseline_playlist_add_24"
                        android:scaleType="centerInside"
                        android:padding="2dp"
                        android:contentDescription="Añadir a lista"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnCompartirSerie"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_button"
                        android:src="@drawable/ic_baseline_share_24"
                        android:scaleType="centerInside"
                        android:padding="2dp"
                        android:contentDescription="Compartir"
                        app:tint="@color/white" />

                    <ImageButton
                    android:id="@+id/btnEnlacesSerie"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/rounded_button"
                    android:src="@drawable/ic_enlace"
                    android:scaleType="centerInside"
                    android:padding="2dp"
                    android:contentDescription="Ver en otras webs"
                    app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>


            <!-- Derecha: de que va y donde verla -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_border_box_big"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/txtSinopsisSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:textSize="15sp"
                        android:justificationMode="inter_word"
                        android:background="@drawable/rounded_border_box"
                        android:fontFamily="@font/courier_prime"
                        android:textColor="@color/colorTextPrimary"
                        tools:text="Un profesor de quimica..." />

                    <TextView
                        android:id="@+id/txtGenerosSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="15sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/courier_prime"
                        android:textColor="@color/colorTextPrimary"
                        tools:text="Drama, Crimen" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/seccionPlataformasSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_border_box_big"
                    android:clipToOutline="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dónde verla"
                        android:textSize="22sp"
                        android:fontFamily="@font/courier_prime_bold"
                        android:textColor="@color/black" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPlataformasSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Temporadas y episodios, a lo ancho -->
        <LinearLayout
            android:id="@+id/seccionTemporadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temporadas"
                android:textSize="22sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTemporadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/txtTemporadaAbierta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/colorTextPrimary"
                tools:text="Temporada 1 · 7 episodios" />

            <ProgressBar
                android:id="@+id/progressEpisodios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/colorAccent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEpisodios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seccionRepartoSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reparto"
                android:textSize="22sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRepartoSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seccionVideosSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vídeos"
                android:textSize="22sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerVideosSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Lo que ha escrito la gente. Va al final, como en la ficha de pelicula: es lo que
        menos se lee y lo que mas ocupa -->
        <LinearLayout
        android:id="@+id/seccionResenasSerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_border_box_big"
        android:clipToOutline="true"
        android:visibility="gone">

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lo que dice la gente"
        android:textSize="22sp"
        android:fontFamily="@font/courier_prime_bold"
        android:textColor="@color/black" />

        <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerResenasSerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/item_resena" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

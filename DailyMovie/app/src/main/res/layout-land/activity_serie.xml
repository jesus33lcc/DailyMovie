<?xml version="1.0" encoding="utf-8"?>
<!--
    La ficha de una serie en apaisado.

    Mismo reparto que la de pelicula: cartel a la izquierda y datos a la derecha. Las
    temporadas y los episodios van debajo a lo ancho, que es donde mas se agradece el sitio
    porque cada episodio lleva su imagen, su fecha y su sinopsis en una fila.

    Los ids son los mismos que en el layout vertical, o ViewBinding rompe SerieA.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.views.SerieA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Izquierda: el cartel y los cuatro datos de cabecera -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_border_box_big"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgPosterSerie"
                    android:layout_width="@dimen/poster_ficha_ancho"
                    android:layout_height="@dimen/poster_ficha_alto"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_border"
                    android:clipToOutline="true"
                    android:contentDescription="Cartel de la serie"
                    tools:src="@drawable/ic_baseline_image_24" />

                <TextView
                    android:id="@+id/txtTituloSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="26sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier_bold"
                    android:textColor="@color/black"
                    tools:text="Breaking Bad" />

                <TextView
                    android:id="@+id/txtDatosSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/courier"
                    android:textColor="@color/colorAccent"
                    tools:text="2008 — 2013 · 5 temporadas · 62 episodios" />

                <TextView
                    android:id="@+id/txtEstadoSerie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/courier_bold"
                    android:background="@drawable/rounded_border"
                    android:textColor="@color/colorTextPrimary"
                    tools:text="Terminada" />
            </LinearLayout>

            <!-- Derecha: de que va y donde verla -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_border_box_big"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/txtSinopsisSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:textSize="15sp"
                        android:justificationMode="inter_word"
                        android:background="@drawable/rounded_border_box"
                        android:fontFamily="@font/courier"
                        android:textColor="@color/colorTextPrimary"
                        tools:text="Un profesor de quimica..." />

                    <TextView
                        android:id="@+id/txtGenerosSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="15sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/courier"
                        android:textColor="@color/colorTextPrimary"
                        tools:text="Drama, Crimen" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/seccionPlataformasSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_border_box_big"
                    android:clipToOutline="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dónde verla"
                        android:textSize="22sp"
                        android:fontFamily="@font/courier_bold"
                        android:textColor="@color/black" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPlataformasSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Temporadas y episodios, a lo ancho -->
        <LinearLayout
            android:id="@+id/seccionTemporadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temporadas"
                android:textSize="22sp"
                android:fontFamily="@font/courier_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTemporadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/txtTemporadaAbierta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:fontFamily="@font/courier_bold"
                android:textColor="@color/colorTextPrimary"
                tools:text="Temporada 1 · 7 episodios" />

            <ProgressBar
                android:id="@+id/progressEpisodios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/colorAccent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEpisodios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seccionRepartoSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reparto"
                android:textSize="22sp"
                android:fontFamily="@font/courier_bold"
                android:textColor="@color/black" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRepartoSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seccionVideosSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vídeos"
                android:textSize="22sp"
                android:fontFamily="@font/courier_bold"
                android:textColor="@color/black" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/paginadorVideosSerie"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    El armazon de todos los dialogos de la app.

    Es uno solo para todos: cada pantalla pone su titulo, su texto y, si hace falta, mete lo
    suyo dentro de dialogoContenido (un campo de texto, una lista de casillas...). Asi no hay
    que repetir el estilo en cada sitio ni se cuela otro dialogo gris de Material.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialogo_fondo"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:fontFamily="@font/courier_bold"
        android:textColor="@color/colorPrimary"
        tools:text="Crear nueva lista" />

    <TextView
        android:id="@+id/dialogoMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="@font/courier"
        android:textColor="@color/white"
        tools:text="Ponle un nombre y podras guardar ahi las peliculas que quieras" />

    <!-- Aqui va lo que cada dialogo necesite: un campo, una lista de casillas, nada... -->
    <FrameLayout
        android:id="@+id/dialogoContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/dialogoCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textSize="16sp"
            android:fontFamily="@font/courier_bold"
            android:textColor="@color/colorPrimary"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            tools:text="Cancelar" />

        <TextView
            android:id="@+id/dialogoAceptar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:textSize="16sp"
            android:fontFamily="@font/courier_bold"
            android:textColor="@color/white"
            android:background="@drawable/dialogo_boton"
            android:clickable="true"
            android:focusable="true"
            tools:text="Crear" />
    </LinearLayout>
</LinearLayout>

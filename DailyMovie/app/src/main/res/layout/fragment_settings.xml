<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".fragments.views.Settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:background="@drawable/rounded_border_box_big"
            android:clipToOutline="true"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes"
                android:textSize="24sp"
                android:fontFamily="@font/courier_prime_bold"
                android:textAlignment="center"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/txtCorreoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:fontFamily="@font/courier_prime"
                android:textAlignment="center"
                android:textColor="@color/colorTextPrimary"
                tools:text="jesus@correo.com" />
        </LinearLayout>

        <!-- Seccion: Tus gustos -->
        <TextView
            style="@style/TituloDeSeccionAjustes"
            android:text="Tus gustos" />

        <Button
            android:id="@+id/btnEditarGustos"
            style="@style/BotonDeAjustes"
            android:text="Editar mis gustos" />

        <Button
            android:id="@+id/btnMisNumeros"
            style="@style/BotonDeAjustes"
            android:text="Tus números" />

        <!-- Seccion: Contenido -->
        <TextView
            style="@style/TituloDeSeccionAjustes"
            android:text="Contenido" />

        <Button
            android:id="@+id/btnIdioma"
            style="@style/BotonDeAjustes"
            android:text="Idioma de las películas" />

        <Button
            android:id="@+id/btnRegion"
            style="@style/BotonDeAjustes"
            android:text="Región" />

        <Button
            android:id="@+id/btnClearHistory"
            style="@style/BotonDeAjustes"
            android:text="Borrar historial" />

        <!-- Seccion: Cuenta -->
        <TextView
            style="@style/TituloDeSeccionAjustes"
            android:text="Cuenta" />

        <Button
            android:id="@+id/btnChangePassword"
            style="@style/BotonDeAjustes"
            android:text="Cambiar contraseña" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/BotonDeAjustes"
            android:text="Cerrar sesión" />

        <!-- Seccion: Privacidad -->
        <TextView
            style="@style/TituloDeSeccionAjustes"
            android:text="Privacidad" />

        <Button
            android:id="@+id/btnPoliticaPrivacidad"
            style="@style/BotonDeAjustes"
            android:text="Política de privacidad" />

        <Button
            android:id="@+id/btnConsentimientoAnalytics"
            style="@style/BotonDeAjustes"
            android:text="Datos de uso" />

        <!-- Se separa del resto porque no tiene vuelta atras -->
        <Button
            android:id="@+id/btnBorrarCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="Borrar mi cuenta y mis datos"
            android:background="@drawable/rounded_border_button"
            android:backgroundTint="#8B2C3B"
            android:textColor="@color/white"
            android:paddingVertical="12dp"
            android:textStyle="bold"
            android:fontFamily="@font/courier_prime_bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="12sp"
            android:textAlignment="center"
            android:fontFamily="@font/courier_prime"
            android:textColor="@color/colorPrimaryDark"
            tools:text="DailyMovie 1.0" />
    </LinearLayout>

</ScrollView>

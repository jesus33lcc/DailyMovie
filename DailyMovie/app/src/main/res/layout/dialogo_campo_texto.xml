<?xml version="1.0" encoding="utf-8"?>
<!--
    El campo de escribir de los dialogos.

    Antes se metia un EditText suelto en el AlertDialog, sin margenes: el cursor tocaba el
    borde de la ventana. Este tiene su caja, su hueco y sitio debajo para el aviso de por que
    ese nombre no vale.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/dialogoCampo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_border_edittext"
        android:padding="14dp"
        android:textSize="16sp"
        android:maxLines="1"
        android:inputType="textCapSentences"
        android:fontFamily="@font/courier_prime"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorAccent"
        android:importantForAutofill="no"
        tools:hint="Nombre de la lista" />

    <TextView
        android:id="@+id/dialogoAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:fontFamily="@font/courier_prime"
        android:textColor="@color/colorPeligroBorde"
        android:visibility="gone"
        tools:text="Ya tienes una lista con ese nombre"
        tools:visibility="visible" />
</LinearLayout>

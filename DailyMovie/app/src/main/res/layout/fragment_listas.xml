<?xml version="1.0" encoding="utf-8"?>
<!--
    Tus listas.

    Antes esto eran cajas dentro de cajas dentro de cajas: cada bloque iba envuelto en un
    rounded_border_box_big, dentro llevaba otro rounded_border_box solo para el titulo, y el
    titulo "Listas" ocupaba una caja entera el solo. Cuatro niveles de marco para enseñar dos
    listas, y el menta a pantalla completa cansaba la vista.

    Ahora son dos secciones planas con su cabecera, como en Explorar, y el boton de crear es
    un FAB abajo a la derecha, que es donde se busca.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".fragments.views.ListasF">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="88dp">

            <TextView
                style="@style/TituloDeSeccionExplorar"
                android:text="Guardadas por ti" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/misListasCheckFav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layoutAnimation="@anim/explore_animation"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_lista_list" />

            <TextView
                style="@style/TituloDeSeccionExplorar"
                android:text="Tus listas" />

            <!-- Cuando el usuario todavia no se ha hecho ninguna lista -->
            <TextView
                android:id="@+id/txtSinListas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center"
                android:text="Todavía no tienes listas tuyas.\n\nToca el + para hacerte una: «Para ver con Silvia», «Pendientes»…"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/courier_prime"
                android:textColor="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/misListaPersonalizadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/explore_animation"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_lista_list" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
        Crear lista. Va de FAB y no de icono perdido en una cabecera: es la unica accion de
        la pantalla y aqui se encuentra sola.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_newLista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Crear una lista"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/colorTextPrimary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

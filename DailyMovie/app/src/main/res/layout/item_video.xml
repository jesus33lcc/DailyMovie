<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/trailerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rounded_border_box_big"
        android:clipToOutline="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/trailerThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/ver_trailer" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_trailer"
            android:contentDescription="@string/ver_trailer" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtVideoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Video Name"
        android:textStyle="bold"
        android:textAlignment="center"
        android:paddingTop="8dp"
        android:ellipsize="end"
        android:maxLines="2" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/rounded_border_box"
    android:clipToOutline="true">

    <TextView
        android:id="@+id/txtNumeroEpisodio"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textSize="22sp"
        android:gravity="center_horizontal"
        android:textAlignment="center"
        android:fontFamily="@font/courier_prime_bold"
        android:textColor="@color/colorPrimaryDark"
        tools:text="1" />

    <!--
        Medida fija y siempre la misma, pase lo que pase con el texto.

        Con match_parent la imagen se estiraba a lo que midiera la fila, asi que en los
        episodios sin sinopsis (los que aun no se han emitido) quedaba aplastada y en los de
        sinopsis larga salia alargada: cada fila con una forma. Ahora manda la imagen y es el
        texto el que se corta si no cabe.
    -->
    <ImageView
        android:id="@+id/imgEpisodio"
        android:layout_width="@dimen/episodio_imagen_ancho"
        android:layout_height="@dimen/episodio_imagen_alto"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_border"
        android:clipToOutline="true"
        android:contentDescription="Imagen del episodio"
        tools:src="@drawable/relleno_fotograma" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloEpisodio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/courier_prime_bold"
            android:textColor="@color/colorTextPrimary"
            tools:text="Piloto" />

        <TextView
            android:id="@+id/txtDatosEpisodio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/courier_prime"
            android:textColor="@color/colorAccent"
            tools:text="20 de enero de 2008 · 58 min" />

        <TextView
            android:id="@+id/txtSinopsisEpisodio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="@font/courier_prime"
            android:textColor="@color/colorTextPrimary"
            tools:text="Un profesor de quimica..." />
    </LinearLayout>

    <!--
        Marcar el episodio como visto.

        Es un ImageButton y no un CheckBox porque el CheckBox de Material trae su propio color
        y su propia animacion, y aqui hace falta el menta de la app. Va a la derecha del todo,
        separado del texto, para que no se pulse sin querer al leer la sinopsis.
    -->
    <ImageButton
        android:id="@+id/btnEpisodioVisto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_baseline_visibility_off_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Marcar como visto" />
</LinearLayout>

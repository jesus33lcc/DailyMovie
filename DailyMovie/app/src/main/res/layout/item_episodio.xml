<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/rounded_border_box"
    android:clipToOutline="true">

    <TextView
        android:id="@+id/txtNumeroEpisodio"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textSize="22sp"
        android:gravity="center_horizontal"
        android:textAlignment="center"
        android:fontFamily="@font/courier_bold"
        android:textColor="@color/colorPrimaryDark"
        tools:text="1" />

    <ImageView
        android:id="@+id/imgEpisodio"
        android:layout_width="120dp"
        android:layout_height="68dp"
        android:layout_marginHorizontal="8dp"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_border"
        android:clipToOutline="true"
        android:contentDescription="Imagen del episodio"
        tools:src="@drawable/ic_baseline_image_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloEpisodio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/courier_bold"
            android:textColor="@color/colorTextPrimary"
            tools:text="Piloto" />

        <TextView
            android:id="@+id/txtDatosEpisodio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/courier"
            android:textColor="@color/colorAccent"
            tools:text="20 de enero de 2008 · 58 min" />

        <TextView
            android:id="@+id/txtSinopsisEpisodio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="@font/courier"
            android:textColor="@color/colorTextPrimary"
            tools:text="Un profesor de quimica..." />
    </LinearLayout>
</LinearLayout>

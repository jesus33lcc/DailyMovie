<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DailyMovie" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="android:fontFamily">@font/courier_prime</item>

    </style>
    <style name="BottomNavViewStyle" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextColor">@color/white</item>
        <item name="backgroundTint">@color/colorBackground</item>
        <item name="itemTextAppearanceActive">@style/BottomNavViewItemStyle</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavViewItemStyle</item>
    </style>
    <style name="Theme.DailyMovie" parent="Base.Theme.DailyMovie">
        <item name="android:windowAnimationStyle">@style/AnimacionDeVentana</item>
        <!-- Hace falta para que el cartel pueda viajar de la tarjeta a la ficha -->
        <item name="android:windowContentTransitions">true</item>
    </style>

    <!--
        Como entran y salen las pantallas.

        Por defecto Android hace un empujon lateral que en una app de fichas queda raro: aqui
        casi siempre se abre algo "encima" (una pelicula, una persona, una saga), asi que la
        nueva sube desde abajo y la de detras se queda apagada al fondo.
    -->
    <style name="AnimacionDeVentana" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/entrar_ficha</item>
        <item name="android:activityOpenExitAnimation">@anim/salir_ficha</item>
        <item name="android:activityCloseEnterAnimation">@anim/volver_entrar</item>
        <item name="android:activityCloseExitAnimation">@anim/volver_salir</item>
    </style>

    <!--
        La pantalla de arranque.

        Sin esto, entre que se toca el icono y se pinta la primera pantalla se veia un
        rectangulo blanco del sistema, que con el azul marino de la app cantaba mucho. Ahora
        se ve el logo sobre el fondo de la app y el salto no se nota.
    -->
    <style name="Theme.DailyMovie.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DailyMovie</item>
    </style>
    <style name="BottomNavViewItemStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Estilos de la pantalla de Ajustes, para no repetir los mismos 8 atributos
         en cada boton ahora que hay bastantes mas -->
    <style name="BotonDeAjustes">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/rounded_border_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/courier_prime_bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TituloDeSeccionAjustes">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/courier_prime_bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!--
        Los menus de tres puntos. Sin esto salen con el blanco de Material, que al lado del
        azul marino del resto canta lo mismo que cantaban los dialogos antes de rehacerlos.
    -->
    <style name="TemaPopupDailyMovie" parent="Base.Theme.DailyMovie">
        <!-- El fondo se cambia en el estilo del widget, no aqui: puesto en el tema no le
             llega al PopupMenu de AppCompat y solo se aplicaba el color del texto, con lo
             que quedaba blanco sobre blanco -->
        <item name="popupMenuStyle">@style/PopupMenuDailyMovie</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="PopupMenuDailyMovie" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/dialogo_fondo</item>
    </style>

    <!-- Los chips de filtrar del buscador -->
    <style name="ChipDeFiltro">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">9dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/courier_prime_bold</item>
        <item name="android:background">@drawable/chip_fondo</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Cabecera de cada bloque de Explorar -->
    <style name="TituloDeSeccionExplorar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/courier_prime_bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- Un cartel de mentira, del mismo tamaño que los de verdad. -->
    <style name="CartelFantasma">
        <item name="android:layout_width">@dimen/poster_ancho</item>
        <item name="android:layout_height">@dimen/poster_alto</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/fondo_fantasma</item>
    </style>
</resources>
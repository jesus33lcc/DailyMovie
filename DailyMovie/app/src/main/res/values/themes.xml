<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DailyMovie" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="android:fontFamily">@font/courier_prime</item>

    </style>
    <style name="BottomNavViewStyle" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextColor">@color/white</item>
        <item name="backgroundTint">@color/colorBackground</item>
        <item name="itemTextAppearanceActive">@style/BottomNavViewItemStyle</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavViewItemStyle</item>
    </style>
    <style name="Theme.DailyMovie" parent="Base.Theme.DailyMovie" />
    <style name="BottomNavViewItemStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Estilos de la pantalla de Ajustes, para no repetir los mismos 8 atributos
         en cada boton ahora que hay bastantes mas -->
    <style name="BotonDeAjustes">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/rounded_border_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/courier_prime_bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TituloDeSeccionAjustes">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/courier_prime_bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!--
        Los menus de tres puntos. Sin esto salen con el blanco de Material, que al lado del
        azul marino del resto canta lo mismo que cantaban los dialogos antes de rehacerlos.
    -->
    <style name="TemaPopupDailyMovie" parent="Base.Theme.DailyMovie">
        <!-- El fondo se cambia en el estilo del widget, no aqui: puesto en el tema no le
             llega al PopupMenu de AppCompat y solo se aplicaba el color del texto, con lo
             que quedaba blanco sobre blanco -->
        <item name="popupMenuStyle">@style/PopupMenuDailyMovie</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="PopupMenuDailyMovie" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/dialogo_fondo</item>
    </style>
</resources>